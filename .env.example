# Copy to .env and edit. Every value is optional; an EMPTY value means "use
# the built-in default".

# The address consoles reach this host on (LAN or VPN IP). It is handed to
# the game inside the protocol, so 127.0.0.1 (the default) only works for
# an emulator on this same machine. Use the same value OpenLobby's .env has.
POL_ADVERTISE=

# Optional allowlist of console addresses, comma-separated. Empty answers
# whoever asks; each address is its own session either way.
POL_DOC_PEER=

# Show the other consoles' characters in each console's lobby: raw (the
# proven mode), wu, or off.
POL_DOC_PEER_RELAY=raw

# Push the lobby's NPC cast (on/off). Needs tools/doc_npc_table.json, your
# own placement table; see README.md. POL_DOC_NPC_SPAWN_ONLY limits the push
# to a comma-separated list of NPC numbers; POL_DOC_NPC_ARENA adds a ring of
# NPCs in the arena (on/off).
POL_DOC_NPC_SPAWN=off
POL_DOC_NPC_SPAWN_ONLY=
POL_DOC_NPC_ARENA=off

# The name of the placeholder character slots a console sees before it has
# created any of its own.
POL_DOC_CHARA_NAME=Quarry
